<?xml version="1.0" encoding="utf-8"?>
<!--
  Файл ответов для повторного прохода OOBE на уже установленной Windows.
  Применяется через sysprep: sysprep.exe /oobe /reboot /unattend:UnattendOOBE.xml
  Запускается скриптом oobe.ps1 (см. соседний файл и windows/README.md).

  Важно: sysprep /oobe обрабатывает ТОЛЬКО проход oobeSystem, поэтому
  windowsPE/specialize здесь намеренно отсутствуют. Полный файл ответов для
  чистой установки с нуля — AutoUnattend.xml.

  Источник идеи: https://www.outsidethebox.ms/22491/
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <!-- Раскладки клавиатуры. Первая в списке — раскладка по умолчанию,
                 поэтому ввод стартует английским; русская доступна переключением -->
            <InputLocale>en-US; ru-RU</InputLocale>
            <!-- Язык для не-Unicode программ (кодовая страница 1251): нужен 1С и старым приложениям -->
            <SystemLocale>ru-RU</SystemLocale>
            <!-- Язык интерфейса системы. Требует, чтобы русский языковой пакет
                 был в образе: на англоязычном образе ставьте ru-RU отдельно,
                 иначе применится UILanguageFallback -->
            <UILanguage>ru-RU</UILanguage>
            <UILanguageFallback>en-US</UILanguageFallback>
            <!-- Региональные форматы: дата ДД.ММ.ГГГГ, запятая как десятичный
                 разделитель, рубль как валюта — как требуется для 1С и бухгалтерии -->
            <UserLocale>ru-RU</UserLocale>
        </component>
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <!-- Часовой пояс. Без него OOBE определяет его сам по региону/сети.
            <TimeZone>Ekaterinburg Standard Time</TimeZone> -->
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <!-- Пропуск экранов входа в учётную запись Microsoft. Работает только
                     вместе с локальной учётной записью ниже -->
                <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
                <!-- 3 — не включать «рекомендуемые» параметры телеметрии -->
                <ProtectYourPC>3</ProtectYourPC>
                <!-- Пропуск настройки Wi-Fi, если сеть не подключена https://t.me/sterkin_ru/1563 -->
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
            </OOBE>
            <UserAccounts>
                <LocalAccounts>
                    <LocalAccount wcm:action="add">
                        <Group>Administrators</Group>
                        <Name>Admin</Name>
                        <!-- Пароль Admin в штатной обфускации unattend (не шифрование, просто
                             base64 от UTF-16LE строки «пароль + Password»). Сгенерировать свой:
                             [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes('МойПароль' + 'Password')) -->
                        <Password>
                            <Value>QQBkAG0AaQBuAFAAYQBzAHMAdwBvAHIAZAA=</Value>
                            <PlainText>false</PlainText>
                        </Password>
                    </LocalAccount>
                </LocalAccounts>
            </UserAccounts>
            <!-- Однократный автовход, чтобы довести первую загрузку до рабочего стола
                 без участия человека. Пароль в том же формате, что выше -->
            <AutoLogon>
                <Password>
                    <Value>QQBkAG0AaQBuAFAAYQBzAHMAdwBvAHIAZAA=</Value>
                    <PlainText>false</PlainText>
                </Password>
                <Username>Admin</Username>
                <LogonCount>1</LogonCount>
                <Enabled>true</Enabled>
            </AutoLogon>
            <!--
              Пост-установка: ПО (с NAS / winget), правки реестра, системные настройки.
              oobe.ps1 заранее кладёт postinstall.ps1 и postinstall.json в
              %ProgramData%\oobe; если их там нет, скрипт берётся из репозитория.
              Профили набора ПО задаются ключом -Profiles (см. postinstall.json).
            -->
            <FirstLogonCommands>
                <SynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <Description>Postinstall: software, registry, system settings</Description>
                    <CommandLine>powershell -ExecutionPolicy Bypass -NoProfile -Command "$p=Join-Path $env:ProgramData 'oobe\postinstall.ps1'; if(Test-Path $p){powershell -ExecutionPolicy Bypass -NoProfile -File $p -Profiles base -NoPrompt}else{iex ((irm 'https://raw.githubusercontent.com/gpas45/scripts/main/windows/oobe/postinstall.ps1' -UseBasicParsing) -replace '^\uFEFF')}"</CommandLine>
                </SynchronousCommand>
                <!-- Потребовать смену пароля при первом входе (снимает «срок действия
                     не ограничен»). Раскомментируйте, если машина уезжает к пользователю.
                <SynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <Description>Require password change at next logon</Description>
                    <CommandLine>powershell -ExecutionPolicy Bypass -NoProfile -Command "Set-LocalUser -Name Admin -PasswordNeverExpires $false; net user Admin /logonpasswordchg:yes"</CommandLine>
                </SynchronousCommand> -->
            </FirstLogonCommands>
        </component>
    </settings>
</unattend>
