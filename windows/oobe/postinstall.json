      "installerUrl": "",
      "profiles": [
        "browser"
      ]
    },
    {
      "name": "VLC",
      "source": "auto",
      "wingetId": "VideoLAN.VLC",
      "nasPath": "VLC/vlc-win64.exe",
      "installerArgs": "/S",
      "installerUrl": "",
      "profiles": [
        "extra"
      ]
    },
    {
      "name": "Far Manager",
      "source": "auto",
      "wingetId": "Far.Far",
      "nasPath": "Far/Far-x64.msi",
      "installerArgs": "/qn /norestart",
      "installerUrl": "",
      "profiles": [
        "extra"
      ]
    },
    {
      "name": "AnyDesk",
      "source": "auto",
      "wingetId": "AnyDeskSoftwareGmbH.AnyDesk",
      "nasPath": "AnyDesk/AnyDesk.exe",
      "installerArgs": "--install \"C:\\Program Files (x86)\\AnyDesk\" --start-with-win --silent",
      "installerUrl": "",
      "profiles": [
        "remote"
      ]
    },
    {
      "name": "КриптоПро ЭЦП Browser plug-in",
      "source": "auto",
      "wingetId": "",
      "nasPath": "CryptoPro/cprocsp-pki-cades-x64.msi",
      "installerArgs": "/qn /norestart",
      "installerUrl": "",
      "profiles": [
        "crypto"
      ],
      "_comment": "wingetId пустой — заполните installerUrl ссылкой на дистрибутив с вашего файлового сервера."
    }
  ],
  "office": {
    "_comment": [
      "mode = odt   — Office Deployment Tool + configuration.xml (Office LTSC, тома).",
      "mode = winget — Microsoft 365 Apps из winget (розничная лицензия).",
      "Выбор редакции и способа активации за вами, поэтому по умолчанию enabled=false.",
      "setupNasPath/configNasPath — пути внутри раздачи NAS; если пусто, ODT ставится",
      "через winget (Microsoft.OfficeDeploymentTool), а конфиг берётся из configUri."
    ],
    "enabled": false,
    "mode": "odt",
    "wingetId": "Microsoft.Office",
    "setupNasPath": "Office/ODT/setup.exe",
    "configNasPath": "Office/ODT/configuration-ProPlus2021Volume.xml",
    "setupPath": "",
    "configPath": "",
    "configUri": "https://raw.githubusercontent.com/gpas45/scripts/main/windows/oobe/office/configuration-ProPlus2021Volume.xml"
  },
