      "nasPath": "AdobeReader/AcroRdrDCx64.exe",
      "installerArgs": "/sAll /rs /msi EULA_ACCEPT=YES",
      "installerUrl": "",
      "profiles": [
        "base"
      ]
    },
    {
      "name": "Notepad++",
      "source": "auto",
